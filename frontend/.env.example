# Base URL of the Miga backend API.
# Only http:// or https:// schemes are used. Copy this file to .env.local and adjust for your setup.
# ASP.NET Core Kestrel URLs configured in backend/src/Miga.Api/Properties/launchSettings.json:
#   http://localhost:5161
#   https://localhost:7168
VITE_API_URL=http://localhost:5161
