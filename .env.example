# Copy to .env for local Docker Compose use. Never commit .env.
POSTGRES_DB=miga_dev
POSTGRES_USER=miga_app
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432

# ASP.NET Core does not automatically read .env files. Export this variable
# in the backend process (or store it with dotnet user-secrets in Development).
ConnectionStrings__MigaDatabase=Host=localhost;Port=5432;Database=miga_dev;Username=miga_app;Password=replace-with-the-same-local-password

# Browser/API deployment configuration. Production values must use HTTPS.
AllowedHosts=localhost
Cors__AllowedOrigins__0=http://localhost:5173
Authentication__PublicBaseUrl=http://localhost:5173
Authentication__RequireConfirmedEmail=false
Authentication__PrivacyPolicyVersion=2026-07-23
Authentication__UserIdleTimeout=00:30:00
Authentication__UserAbsoluteTimeout=1.00:00:00
Authentication__DemoIdleTimeout=00:30:00
Authentication__DemoAbsoluteTimeout=02:00:00
Authentication__RecentAuthenticationWindow=00:10:00
Health__ExposeDatabaseEndpoint=false

# Only configure proxy addresses that are controlled by the deployment.
# TrustedProxies__Addresses__0=10.0.0.10
# TrustedProxies__ForwardLimit=1

# Storage and cleanup limits. Raise them only after load/cost review.
Demo__MaximumSnapshotBytes=262144
Demo__RegisteredMaximumSnapshotBytes=5242880
Demo__CleanupInterval=00:15:00

# Optional email delivery. Production must provide real values and enable it
# before requiring email confirmation. Do not put real credentials here.
Smtp__Enabled=false
Smtp__Host=
Smtp__Port=587
Smtp__UseSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=

# Production requires an X.509 certificate that encrypts the persisted
# ASP.NET Core Data Protection key ring. Mount it read-only outside the repo.
DataProtection__CertificatePath=
DataProtection__CertificatePassword=

# Optional YouTube Data API key. Keep the real value in a secrets manager.
YouTubeApi__Enabled=false
YouTubeApi__ApiKey=
YouTubeApi__CacheTtl=1.00:00:00
