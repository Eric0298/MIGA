# PostgreSQL runtime connection. Production requires SSL Mode=VerifyFull and
# Trust Server Certificate=false. Set Root Certificate=<mounted-ca-path> for a private CA.
ConnectionStrings__MigaDatabase=Host=localhost;Port=5432;Database=miga_dev;Username=miga_app;Password=<local-only-password>

# Reference production topology: the browser uses https://app.example.com/api and a reverse proxy
# forwards /api to ASP.NET Core. The proxy preserves Host=app.example.com in this example.
# If your proxy rewrites Host, AllowedHosts must contain that exact effective host instead.
# Keep CORS exact as defense in depth; never use a wildcard with credentialed cookies.
Cors__AllowedOrigins__0=https://app.example.com
AllowedHosts=app.example.com

# Public browser URL used to construct email links. It is never derived from the Host header.
Authentication__PublicBaseUrl=https://app.example.com
Authentication__RequireConfirmedEmail=true
Authentication__PrivacyPolicyVersion=2026-07-23
# Cleanup deletes unconfirmed accounts after this lifetime, or earlier if their linked demo expires.
Authentication__UnconfirmedAccountLifetime=7.00:00:00
Authentication__UserIdleTimeout=00:30:00
Authentication__UserAbsoluteTimeout=1.00:00:00
Authentication__DemoIdleTimeout=00:30:00
Authentication__DemoAbsoluteTimeout=02:00:00
Authentication__RecentAuthenticationWindow=00:10:00

# Storage and cleanup limits. Raise them only after load/cost review.
Demo__MaximumSnapshotBytes=262144
Demo__RegisteredMaximumSnapshotBytes=5242880
Demo__CleanupInterval=00:15:00

# Transactional email is mandatory in production when confirmed email is required.
# Pick exactly one delivery provider via EmailDelivery__Provider:
#   * BrevoApi  — HTTPS API to https://api.brevo.com (works on Railway Trial/Hobby;
#                 the SMTP outbound ports are blocked on those plans).
#   * Smtp      — legacy System.Net.Mail path (needs a plan that allows outbound
#                 25/587/465/2525).
#   * Disabled  — non-production only; startup fails in production when
#                 Authentication__RequireConfirmedEmail=true.
EmailDelivery__Provider=BrevoApi

# BrevoApi provider — the ApiKey MUST be delivered as a sealed variable in
# Railway / Vault / etc. and never appears in this file. The FromAddress must
# match the verified sender identity configured in Brevo.
Brevo__ApiKey=<sealed-brevo-api-key>
Brevo__FromAddress=no-reply@ericmancebo.com
Brevo__FromName=MIGA

# SMTP alternative — only used when EmailDelivery__Provider=Smtp. Left here
# for parity with hosts that permit outbound SMTP; leaving these values set
# while Provider=BrevoApi is safe and will not gate startup.
Smtp__Enabled=true
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__UseSsl=true
Smtp__Username=<smtp-user>
Smtp__Password=<smtp-password>
Smtp__FromAddress=no-reply@example.com

# Certificate used to encrypt the persisted ASP.NET Core Data Protection key ring.
# Configure EXACTLY ONE of CertificatePath (mounted PFX file) or CertificateBase64
# (sealed secret containing the PFX bytes base64-encoded). Never commit either value.
#
# Rotation is not a single-variable swap. Replacing the certificate here without
# a transition period leaves keys encrypted by the previous certificate
# undecryptable, invalidating existing cookies/tokens. A safe rotation requires:
#   1. Add the new certificate under ProtectKeysWithCertificate for new keys.
#   2. Keep the previous certificate available under UnprotectKeysWithAnyCertificate
#      so keys encrypted with it can still be read.
#   3. Wait until the oldest Data Protection key encrypted with the previous
#      certificate has expired (default key lifetime is 90 days).
#   4. Confirm decryption works with only the new certificate before removing
#      the previous one.
# The application currently only wires ProtectKeysWithCertificate, so
# implementing UnprotectKeysWithAnyCertificate is required before the first
# rotation and is tracked as a follow-up.
DataProtection__CertificatePath=<mounted-pkcs12-path>
# DataProtection__CertificateBase64=<sealed-base64-pfx>
DataProtection__CertificatePassword=<certificate-password>

# Optional external integration. Keep disabled until a restricted server-side key exists.
YouTubeApi__Enabled=false
YouTubeApi__ApiKey=<restricted-youtube-api-key>
YouTubeApi__CacheTtl=1.00:00:00

# Set only to the actual reverse proxy IPs. Client-provided forwarding headers are otherwise ignored.
TrustedProxies__Addresses__0=127.0.0.1
# For PaaS ingress that does not publish stable proxy IPs, trust the private-network CIDR
# range the proxy connects from. Railway's HTTP proxy reaches containers from RFC 6598
# CGNAT space (100.64.0.0/10) and IPv6 ULA (fd12::/16); trust both alongside the
# in-project 10/8 private range. These ranges are not publicly routable, so trusting them
# only permits the platform's own edge to set X-Forwarded-Proto/For.
# TrustedProxies__Networks__0=10.0.0.0/8
# TrustedProxies__Networks__1=100.64.0.0/10
# TrustedProxies__Networks__2=fd12::/16
TrustedProxies__ForwardLimit=1

# Do not expose database dependency details publicly without an operational need.
Health__ExposeDatabaseEndpoint=false
