# PostgreSQL runtime connection. Production requires SSL Mode=VerifyFull and
# Trust Server Certificate=false. Set Root Certificate=<mounted-ca-path> for a private CA.
ConnectionStrings__MigaDatabase=Host=localhost;Port=5432;Database=miga_dev;Username=miga_app;Password=<local-only-password>

# Reference production topology: the browser uses https://app.example.com/api and a reverse proxy
# forwards /api to ASP.NET Core. The proxy preserves Host=app.example.com in this example.
# If your proxy rewrites Host, AllowedHosts must contain that exact effective host instead.
# Keep CORS exact as defense in depth; never use a wildcard with credentialed cookies.
Cors__AllowedOrigins__0=https://app.example.com
AllowedHosts=app.example.com

# Public browser URL used to construct email links. It is never derived from the Host header.
Authentication__PublicBaseUrl=https://app.example.com
Authentication__RequireConfirmedEmail=true
Authentication__PrivacyPolicyVersion=2026-07-23
Authentication__UserIdleTimeout=00:30:00
Authentication__UserAbsoluteTimeout=1.00:00:00
Authentication__DemoIdleTimeout=00:30:00
Authentication__DemoAbsoluteTimeout=02:00:00
Authentication__RecentAuthenticationWindow=00:10:00

# Storage and cleanup limits. Raise them only after load/cost review.
Demo__MaximumSnapshotBytes=262144
Demo__RegisteredMaximumSnapshotBytes=5242880
Demo__CleanupInterval=00:15:00

# SMTP is mandatory in production when confirmed email is required.
Smtp__Enabled=true
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__UseSsl=true
Smtp__Username=<smtp-user>
Smtp__Password=<smtp-password>
Smtp__FromAddress=no-reply@example.com

# Certificate used to encrypt the persisted ASP.NET Core Data Protection key ring.
DataProtection__CertificatePath=<mounted-pkcs12-path>
DataProtection__CertificatePassword=<certificate-password>

# Optional external integration. Keep disabled until a restricted server-side key exists.
YouTubeApi__Enabled=false
YouTubeApi__ApiKey=<restricted-youtube-api-key>
YouTubeApi__CacheTtl=1.00:00:00

# Set only to the actual reverse proxy IPs. Client-provided forwarding headers are otherwise ignored.
TrustedProxies__Addresses__0=127.0.0.1
TrustedProxies__ForwardLimit=1

# Do not expose database dependency details publicly without an operational need.
Health__ExposeDatabaseEndpoint=false
