{
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "MigaDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "TrustedProxies": {
    "Addresses": [],
    "Networks": [],
    "ForwardLimit": 1
  },
  "Authentication": {
    "RequireConfirmedEmail": true,
    "PublicBaseUrl": "",
    "PrivacyPolicyVersion": "2026-07-23",
    "UserIdleTimeout": "00:30:00",
    "UserAbsoluteTimeout": "1.00:00:00",
    "DemoIdleTimeout": "00:30:00",
    "DemoAbsoluteTimeout": "02:00:00",
    "RecentAuthenticationWindow": "00:10:00",
    "UnconfirmedAccountLifetime": "7.00:00:00"
  },
  "EmailDelivery": {
    "Provider": "Disabled"
  },
  "Brevo": {
    "ApiKey": "",
    "FromAddress": "",
    "FromName": ""
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": ""
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificateBase64": "",
    "CertificatePassword": ""
  },
  "Demo": {
    "MaximumSnapshotBytes": 262144,
    "RegisteredMaximumSnapshotBytes": 5242880,
    "CleanupInterval": "00:15:00"
  },
  "Health": {
    "ExposeDatabaseEndpoint": false
  },
  "YouTubeApi": {
    "Enabled": false,
    "ApiKey": "",
    "CacheTtl": "1.00:00:00"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Properties": {
      "Application": "Miga.Api"
    }
  }
}
